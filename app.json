{
  "expo": {
    "name": "Dayli",
    "slug": "dayli",
    "scheme": "dayli",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F4",
      "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#17181C" }
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "app.dayli.mobile" },
    "android": {
      "package": "app.dayli.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F4"
      }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Dayli uses the microphone for voice notes, so you can say your week instead of typing it."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
